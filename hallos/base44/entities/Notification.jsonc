{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of this inbox item"
    },
    "hall_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "announcement",
        "report",
        "system"
      ]
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "related_id": {
      "type": "string",
      "description": "Announcement or report id this item refers to"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high",
        "urgent"
      ]
    },
    "is_read": {
      "type": "boolean"
    },
    "acknowledged_at": {
      "type": "string",
      "format": "date-time"
    },
    "is_demo": {
      "type": "boolean"
    }
  },
  "required": [
    "user_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}