{
  "name": "SharedSpace",
  "type": "object",
  "properties": {
    "hall_id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "e.g. Floor 3 shared bathroom"
    },
    "floor": {
      "type": "string"
    },
    "space_type": {
      "type": "string",
      "enum": [
        "bathroom",
        "shower",
        "laundry",
        "trash",
        "kitchen",
        "hallway",
        "lounge",
        "other"
      ]
    },
    "is_demo": {
      "type": "boolean"
    }
  },
  "required": [
    "hall_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.hall_id": "{{user.data.hall_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}